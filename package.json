{
  "name": "woundwise-platform",
  "version": "1.0.0",
  "description": "WoundWise Full-Stack Clinical Wound Care Tracking & Documentation Application",
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "migrate": "cd backend && npm run migrate",
    "install:all": "cd backend && npm install && cd ../frontend && npm install"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.3",
    "uuid": "^11.1.0"
  },
  "keywords": [
    "woundwise",
    "wound-tracking",
    "fullstack",
    "react",
    "express",
    "postgresql"
  ],
  "author": "",
  "license": "ISC"
}
