# WoundWise Backend Environment Configuration

# Server
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_EXPIRES_IN=7d

# PostgreSQL Database (Required for production, automatic fallback available for dev)
DATABASE_URL=postgresql://postgres:password@localhost:5432/woundwise_db
# Or individual parameters:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=password
# PGDATABASE=woundwise_db
# DATABASE_SSL=false

# AI Model Integration (Leave blank to keep "Analysis not configured" mode)
# If provided, connects to the AI wound assessment model
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Frontend Origin for CORS
CLIENT_URL=http://localhost:5173
